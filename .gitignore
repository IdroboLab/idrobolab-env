# Generated / staged build inputs — regenerated by prepare_build_context.sh
# (the pinned requirements-*.txt ARE tracked; the staged source trees are not).
# ** so the pattern survives layout changes: the platform reorganization
# (containers/<stack>/ -> containers/<platform>/<stack>/) silently defeated
# the old single-level pattern and 5781 staged files slipped into history
# (purged 2026-08-26).
shared/containers/**/src/

# Built container images and exports — never commit (multi-GB)
*.sif
*.img
*.tar
*.tar.gz

# Build + job logs kept out of the recipe area
build.log

# Python / editor cruft
__pycache__/
*.pyc
.DS_Store
